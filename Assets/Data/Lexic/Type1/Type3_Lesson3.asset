  lessonTitle: "\u0423\u0440\u043E\u043A 2"
  cards:
  - foreignWord: "\u6A59\u5B50"
    translation: "\u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D"
    image: {fileID: 0}
    exampleForeign: "\u6628\u5929\u6211\u4E70\u4E86\u4E24\u4E2A\u6A59\u5B50\uFF0C\u5F53\u65E9\u996D\u5403\u4E86\u3002"
    exampleTranslation: "\u0412\u0447\u0435\u0440\u0430 \u044F \u043A\u0443\u043F\u0438\u043B
      \u0434\u0432\u0430 \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u0430 \u0438
      \u0441\u044A\u0435\u043B \u0438\u0445 \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A. "
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 00643eb9a6e404e168c8e6815c7895c0, type: 3}
  - foreignWord: "\u4E09\u660E\u6CBB"
    translation: "\u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434"
    image: {fileID: 0}
    exampleForeign: "\u901A\u5E38\u65E9\u4E0A\u6211\u505A\u4E00\u4E2A\u5976\u916A\u4E09\u660E\u6CBB\uFF0C\u7136\u540E\u559D\u8336\u3002"
    exampleTranslation: "\u041E\u0431\u044B\u0447\u043D\u043E \u0443\u0442\u0440\u043E\u043C
      \u044F \u0434\u0435\u043B\u0430\u044E \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434
      \u0441 \u0441\u044B\u0440\u043E\u043C \u0438 \u043F\u044C\u044E \u0447\u0430\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: d323fa5693506436d994fe42f6ff9c65, type: 3}
  - foreignWord: "\u74F6\u5B50"
    translation: "\u0431\u0443\u0442\u044B\u043B\u043A\u0430"
    image: {fileID: 0}
    exampleForeign: "\u4ED6\u6253\u5F00\u4E00\u74F6\u6C34\uFF0C\u5012\u8FDB\u676F\u5B50\u91CC\u3002"
    exampleTranslation: "\u041E\u043D \u043E\u0442\u043A\u0440\u044B\u043B \u0431\u0443\u0442\u044B\u043B\u043A\u0443
      \u0432\u043E\u0434\u044B \u0438 \u043D\u0430\u043B\u0438\u043B \u0432 \u0441\u0442\u0430\u043A\u0430\u043D."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 08d56242e2ebb401190e1466520a7a99, type: 3}
  - foreignWord: "\u73A9\u5177"
    translation: "\u0438\u0433\u0440\u0443\u0448\u043A\u0430"
    image: {fileID: 0}
    exampleForeign: "\u5C0F\u5973\u5B69\u5728\u516C\u56ED\u91CC\u73A9\u4E00\u4E2A\u65B0\u73A9\u5177\u3002"
    exampleTranslation: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u0434\u0435\u0432\u043E\u0447\u043A\u0430
      \u0438\u0433\u0440\u0430\u043B\u0430 \u0441 \u043D\u043E\u0432\u043E\u0439
      \u0438\u0433\u0440\u0443\u0448\u043A\u043E\u0439 \u0432 \u043F\u0430\u0440\u043A\u0435."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 7c35c77ed7b9d4fffa6f130bcdb626f9, type: 3}
  - foreignWord: "\u7CD6\u679C"
    translation: "\u043A\u043E\u043D\u0444\u0435\u0442\u0430"
    image: {fileID: 0}
    exampleForeign: "\u5976\u5976\u9001\u7ED9\u5B59\u5B50\u597D\u5403\u7684\u7CD6\u679C\u3002"
    exampleTranslation: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0430
      \u0432\u043D\u0443\u043A\u0443 \u0432\u043A\u0443\u0441\u043D\u044B\u0435 \u043A\u043E\u043D\u0444\u0435\u0442\u044B."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 9ec101e687efd4f28a1ea031aeb79b43, type: 3}
  - foreignWord: "\u5939\u514B"
    translation: "\u043A\u0443\u0440\u0442\u043A\u0430"
    image: {fileID: 0}
    exampleForeign: "\u5916\u9762\u51B7\uFF0C\u6240\u4EE5\u6211\u7A7F\u4E0A\u4E86\u6696\u548C\u7684\u5939\u514B\u3002"
    exampleTranslation: "\u041D\u0430 \u0443\u043B\u0438\u0446\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u043D\u0430\u0434\u0435\u043B
      \u0442\u0451\u043F\u043B\u0443\u044E \u043A\u0443\u0440\u0442\u043A\u0443."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: c77a482ec2a504d2d8a0aae9e4cc705c, type: 3}
  - foreignWord: "\u836F"
    translation: "\u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E"
    image: {fileID: 0}
    exampleForeign: "\u65E9\u4E0A\u6211\u5FD8\u4E86\u53BB\u836F\u5E97\u4E70\u836F\u3002"
    exampleTranslation: "\u0423\u0442\u0440\u043E\u043C \u044F \u0437\u0430\u0431\u044B\u043B
      \u043A\u0443\u043F\u0438\u0442\u044C \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E
      \u0432 \u0430\u043F\u0442\u0435\u043A\u0435."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: a780bd76e74fe4599a71989e69717599, type: 3}
  - foreignWord: "\u86CB\u7CD5"
    translation: "\u0442\u043E\u0440\u0442"
    image: {fileID: 0}
    exampleForeign: "\u5979\u81EA\u5DF1\u505A\u4E86\u4E00\u4E2A\u5927\u86CB\u7CD5\uFF0C\u8BF7\u670B\u53CB\u4EEC\u6765\u559D\u8336\u3002"
    exampleTranslation: "\u041E\u043D\u0430 \u0441\u0430\u043C\u0430 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u043E\u0440\u0442 \u0438
      \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B\u0430 \u0434\u0440\u0443\u0437\u0435\u0439
      \u043D\u0430 \u0447\u0430\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 78040bd14b1ad4def891414c6c2ff054, type: 3}
  - foreignWord: "\u89C6\u9891"
    translation: "\u0432\u0438\u0434\u0435\u043E"
    image: {fileID: 0}
    exampleForeign: "\u6628\u5929\u6211\u4EEC\u770B\u4E86\u4E00\u4E2A\u5173\u4E8E\u65C5\u884C\u7684\u6709\u8DA3\u89C6\u9891\u3002"
    exampleTranslation: "\u0412\u0447\u0435\u0440\u0430 \u043C\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0435 \u0432\u0438\u0434\u0435\u043E
      \u043E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044F\u0445."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: a3f936f3c546042e897415e357febaa7, type: 3}
  - foreignWord: "\u7167\u76F8\u673A"
    translation: "\u0444\u043E\u0442\u043E\u0430\u043F\u043F\u0430\u0440\u0430\u0442"
    image: {fileID: 0}
    exampleForeign: "\u4ED6\u62FF\u8D77\u76F8\u673A\uFF0C\u62CD\u4E0B\u4E86\u7F8E\u4E3D\u7684\u65E5\u843D\u3002"
    exampleTranslation: "\u041E\u043D \u0432\u0437\u044F\u043B \u0444\u043E\u0442\u043E\u0430\u043F\u043F\u0430\u0440\u0430\u0442
      \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u043E\u0432\u0430\u043B
      \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0437\u0430\u043A\u0430\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 2b58304ebfd76473db73b8c3c12afff2, type: 3}
