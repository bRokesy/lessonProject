  m_Script: {fileID: 11500000, guid: e5d41a317c25b604483e6ad55bbda19e, type: 3}
  m_Name: Type3_Lesson2
  m_EditorClassIdentifier: Assembly-CSharp::FlashcardDeckData
  lessonTitle: "\u0423\u0440\u043E\u043A 2"
  cards:
  - foreignWord: "\u95EE\u9898"
    translation: "\u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 "
    image: {fileID: 0}
    exampleForeign: "\u6211\u6709\u4E2A\u95EE\u9898\uFF0C\u6211\u4E0D\u660E\u767D\u8FD9\u4E2A\u4F5C\u4E1A"
    exampleTranslation: "\u0423 \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430,
      \u044F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E \u044D\u0442\u043E
      \u0437\u0430\u0434\u0430\u043D\u0438\u0435."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 7f704698692d7480e88b1d0e4a536c3d, type: 3}
  - foreignWord: "\u5206\u949F"
    translation: "\u043C\u0438\u043D\u0443\u0442\u0430"
    image: {fileID: 0}
    exampleForeign: "\u8BF7\u7B49\u6211\u5341\u5206\u949F\uFF0C\u6211\u9A6C\u4E0A\u5C31\u6765"
    exampleTranslation: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438 10 \u043C\u0438\u043D\u0443\u0442,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u044F \u0443\u0436\u0435
      \u0438\u0434\u0443."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: a1153cab242be4c1a9df4fc95578ac98, type: 3}
  - foreignWord: "\u5C0F\u65F6"
    translation: "\u0447\u0430\u0441"
    image: {fileID: 0}
    exampleForeign: "\u6211\u6BCF\u5929\u5B66\u4E00\u5C0F\u65F6\u4FC4\u8BED"
    exampleTranslation: "\u042F \u0443\u0447\u0443 \u0440\u0443\u0441\u0441\u043A\u0438\u0439
      \u044F\u0437\u044B\u043A \u043E\u0434\u0438\u043D \u0447\u0430\u0441 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0435\u043D\u044C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: bdc06fb1be05a46c69bc465f75f086ae, type: 3}
  - foreignWord: "\u804C\u4E1A"
    translation: "\u0437\u0430\u043D\u044F\u0442\u0438\u0435"
    image: {fileID: 0}
    exampleForeign: "\u6211\u5728\u533B\u9662\u5DE5\u4F5C\uFF0C\u6211\u7684\u804C\u4E1A\u662F\u533B\u751F\u3002"
    exampleTranslation: "\u042F \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u0432
      \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435. \u041C\u043E\u0451 \u0437\u0430\u043D\u044F\u0442\u0438\u0435
      \u2013 \u0432\u0440\u0430\u0447. "
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: acfe54abe0c324b11b08acf9fbccca25, type: 3}
  - foreignWord: "\u65F6\u523B"
    translation: "\u043C\u043E\u043C\u0435\u043D\u0442"
    image: {fileID: 0}
    exampleForeign: "\u6211\u5728\u8FD9\u4E2A\u65F6\u523B\u542C\u97F3\u4E50\u3002"
    exampleTranslation: "\u0412 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442
      \u044F \u0441\u043B\u0443\u0448\u0430\u044E \u043C\u0443\u0437\u044B\u043A\u0443"
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 4d5ce1fef7ecd4155a90b55d53a1943b, type: 3}
  - foreignWord: "\u4EA7\u54C1/\u98DF\u54C1"
    translation: "\u043F\u0440\u043E\u0434\u0443\u043A\u0442"
    image: {fileID: 0}
    exampleForeign: "\u5546\u5E97\u91CC\u6709\u65B0\u9C9C\u7684\u98DF\u54C1\uFF1A\u725B\u5976\u3001\u9762\u5305\u548C\u5976\u916A\u3002"
    exampleTranslation: "\u0412 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435
      \u0435\u0441\u0442\u044C \u0441\u0432\u0435\u0436\u0438\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B:
      \u043C\u043E\u043B\u043E\u043A\u043E, \u0445\u043B\u0435\u0431 \u0438 \u0441\u044B\u0440."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 7c0af61f7d956425b9b89e603a303449, type: 3}
  - foreignWord: "\u4F20\u771F(\u673A)"
    translation: "\u0444\u0430\u043A\u0441"
    image: {fileID: 0}
    exampleForeign: "\u8BF7\u628A\u4FE1\u606F\u53D1\u4F20\u771F\u7ED9\u6211\u3002"
    exampleTranslation: "\u041F\u043E\u0448\u043B\u0438 \u043C\u043D\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u043F\u043E \u0444\u0430\u043A\u0441\u0443, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 7e0e1ffb722f24359b39af7a1382b3ce, type: 3}
  - foreignWord: "\u4E8B\u60C5"
    translation: "\u0434\u0435\u043B\u043E"
    image: {fileID: 0}
    exampleForeign: "\u6211\u4ECA\u5929\u6709\u5F88\u591A\u4E8B\u60C5\u8981\u505A\u3002"
    exampleTranslation: "\u0423 \u043C\u0435\u043D\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E
      \u0434\u0435\u043B."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 3bff35dc8e606416ea0bd4efd66a84d2, type: 3}
  - foreignWord: "\u4F11\u606F/\u653E\u5047"
    translation: "\u043E\u0442\u0434\u044B\u0445"
    image: {fileID: 0}
    exampleForeign: "\u590F\u5929\u5B66\u751F\u653E\u5047\uFF0C\u4ED6\u4EEC\u901A\u5E38\u56DE\u4E2D\u56FD\u3002"
    exampleTranslation: "\u041B\u0435\u0442\u043E\u043C \u0443 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u0432
      \u043E\u0442\u0434\u044B\u0445, \u043E\u043D\u0438 \u043E\u0431\u044B\u0447\u043D\u043E
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u0432
      \u041A\u0438\u0442\u0430\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 26ef229df07e544329fa80ddb8ba08e5, type: 3}
  - foreignWord: "\u53D1/\u5BC4\u4FE1"
    translation: "\u043F\u043E\u0441\u044B\u043B\u0430\u0442\u044C \u2013 \u043F\u043E\u0441\u043B\u0430\u0442\u044C "
    image: {fileID: 0}
    exampleForeign: "\u6211\u7ECF\u5E38\u7ED9\u5976\u5976\u5BC4\u4FE1\u3002"
    exampleTranslation: "\u042F \u0447\u0430\u0441\u0442\u043E \u043F\u043E\u0441\u044B\u043B\u0430\u044E
      \u043F\u0438\u0441\u044C\u043C\u0430 \u0431\u0430\u0431\u0443\u0448\u043A\u0435."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: abbb14f87d6714b3ba1e430dbef85ba9, type: 3}
