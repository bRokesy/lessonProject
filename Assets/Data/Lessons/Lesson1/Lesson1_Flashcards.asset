  m_Script: {fileID: 11500000, guid: e5d41a317c25b604483e6ad55bbda19e, type: 3}
  m_Name: Lesson1_Flashcards
  m_EditorClassIdentifier: Assembly-CSharp::FlashcardDeckData
  lessonTitle: "\u0423\u0440\u043E\u043A 1"
  cards:
  - foreignWord: "\u7533\u8BF7\u8868"
    translation: "\u0430\u043D\u043A\u0435\u0442\u0430"
    image: {fileID: 0}
    exampleForeign: "\u5728\u5B66\u6821\uFF0C\u8001\u5E08\u7ED9\u4E86\u6211\u4EEC\u4E00\u5F20\u7533\u8BF7\u8868\uFF0C\u6211\u5728\u4E0A\u9762\u5199\u4E0A\u4E86\u81EA\u5DF1\u7684\u540D\u5B57\u3001\u59D3\u6C0F\u3001\u5E74\u9F84\u548C\u5730\u5740\u3002"
    exampleTranslation: "\u0412 \u0448\u043A\u043E\u043B\u0435 \u0443\u0447\u0438\u0442\u0435\u043B\u044C
      \u0434\u0430\u043B \u043D\u0430\u043C \u0430\u043D\u043A\u0435\u0442\u0443,
      \u0438 \u044F \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u0432 \u043D\u0435\u0439
      \u0441\u0432\u043E\u0451 \u0438\u043C\u044F, \u0444\u0430\u043C\u0438\u043B\u0438\u044E,
      \u0432\u043E\u0437\u0440\u0430\u0441\u0442 \u0438 \u0430\u0434\u0440\u0435\u0441."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 6bc56cd2640164584acbfb3acac7a789, type: 3}
  - foreignWord: "\u5BF9\u8BDD"
    translation: "\u0434\u0438\u0430\u043B\u043E\u0433"
    image: {fileID: 0}
    exampleForeign: "\u5728\u4FC4\u8BED\u8BFE\u4E0A\uFF0C\u6211\u4EEC\u8BFB\u4E86\u4E00\u4E2A\u7B80\u77ED\u7684\u670B\u53CB\u4E4B\u95F4\u7684\u5BF9\u8BDD\u3002"
    exampleTranslation: "\u041D\u0430 \u0443\u0440\u043E\u043A\u0435 \u0440\u0443\u0441\u0441\u043A\u043E\u0433\u043E
      \u044F\u0437\u044B\u043A\u0430 \u043C\u044B \u0447\u0438\u0442\u0430\u043B\u0438
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0434\u0438\u0430\u043B\u043E\u0433
      \u0434\u0432\u0443\u0445 \u0434\u0440\u0443\u0437\u0435\u0439"
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 6ea468d5806244c5cb6c32b3508dd89d, type: 3}
  - foreignWord: "\u8BFE\u9898"
    translation: "\u0437\u0430\u0434\u0430\u043D\u0438\u0435"
    image: {fileID: 0}
    exampleForeign: "\u5728\u4FC4\u8BED\u8BFE\u4E0A\uFF0C\u6211\u4EEC\u8BFB\u4E86\u4E00\u4E2A\u7B80\u77ED\u7684\u670B\u53CB\u4E4B\u95F4\u7684\u5BF9\u8BDD\u3002"
    exampleTranslation: "\u0414\u043E\u043C\u0430 \u044F \u0434\u0435\u043B\u0430\u043B
      \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u043F\u043E \u0440\u0443\u0441\u0441\u043A\u043E\u043C\u0443
      \u044F\u0437\u044B\u043A\u0443: \u044F \u043F\u0438\u0441\u0430\u043B \u043D\u043E\u0432\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430 \u0438 \u0447\u0438\u0442\u0430\u043B \u0442\u0435\u043A\u0441\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 4c6e33ff53800443b9044930d80cf0c3, type: 3}
  - foreignWord: "\u6D88\u606F"
    translation: "\u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435"
    image: {fileID: 0}
    exampleForeign: "\u6628\u5929\u665A\u4E0A\uFF0C\u6211\u5728\u624B\u673A\u4E0A\u6536\u5230\u4E86\u670B\u53CB\u53D1\u6765\u7684\u6D88\u606F\uFF0C\u6211\u7ACB\u523B\u56DE\u590D\u4E86\u4ED6\u3002"
    exampleTranslation: "\u0412\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C
      \u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435
      \u043E\u0442 \u043C\u043E\u0435\u0433\u043E \u0434\u0440\u0443\u0433\u0430
      \u0432 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435, \u0438 \u044F \u0441\u0440\u0430\u0437\u0443
      \u043E\u0442\u0432\u0435\u0442\u0438\u043B \u043D\u0430 \u043D\u0435\u0433\u043E."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: f04da0823847948c489304b9513cef82, type: 3}
  - foreignWord: "\u7AE5\u8BDD"
    translation: "\u0441\u043A\u0430\u0437\u043A\u0430"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u8001\u5E08\u7ED9\u4E86\u6211\u4E00\u4E2A\u597D\u5EFA\u8BAE\uFF1A\u201C\u6BCF\u5929\u542C\u4FC4\u8BED\u97F3\u4E50\uFF0C\u8BFB\u8BFE\u6587\u3002\u201D"
    exampleTranslation: "\u041C\u043E\u0439 \u0443\u0447\u0438\u0442\u0435\u043B\u044C
      \u0434\u0430\u043B \u043C\u043D\u0435 \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0441\u043E\u0432\u0435\u0442: \xAB\u041A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C
      \u0441\u043B\u0443\u0448\u0430\u0439 \u0440\u0443\u0441\u0441\u043A\u0443\u044E
      \u043C\u0443\u0437\u044B\u043A\u0443 \u0438 \u0447\u0438\u0442\u0430\u0439
      \u0442\u0435\u043A\u0441\u0442\u044B\xBB."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: f9e821a80652f486f8ac754873cc10d6, type: 3}
  - foreignWord: "\u5EFA\u8BAE"
    translation: "\u0441\u043E\u0432\u0435\u0442"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u54E5\u54E5\u559C\u6B22\u79D1\u5B66\uFF0C\u4ED6\u8BFB\u5173\u4E8E\u7269\u7406\u548C\u5316\u5B66\u7684\u4E66\uFF0C\u800C\u6211\u8FD8\u4E0D\u592A\u61C2\u79D1\u5B66\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0431\u0440\u0430\u0442 \u043B\u044E\u0431\u0438\u0442
      \u043D\u0430\u0443\u043A\u0443, \u043E\u043D \u0447\u0438\u0442\u0430\u0435\u0442
      \u043A\u043D\u0438\u0433\u0438 \u043F\u0440\u043E \u0444\u0438\u0437\u0438\u043A\u0443
      \u0438 \u0445\u0438\u043C\u0438\u044E, \u0430 \u044F \u043F\u043E\u043A\u0430
      \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u043D\u0438\u043C\u0430\u044E
      \u043D\u0430\u0443\u043A\u0443."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: a5bdc0c649e92420892dae8e7f1fe11d, type: 3}
  - foreignWord: "\u53E5\u8BDD"
    translation: "\u0444\u0440\u0430\u0437\u0430"
    image: {fileID: 0}
    exampleForeign: "\u6211\u5B66\u4F1A\u4E86\u4E00\u4E2A\u65B0\u7684\u4FC4\u8BED\u77ED\u8BED\uFF1A\u201C\u51FA\u53D1\uFF01\u201D
      \u73B0\u5728\u6211\u603B\u662F\u8BF4\u8FD9\u53E5\u8BDD\u3002"
    exampleTranslation: "\u042F \u0432\u044B\u0443\u0447\u0438\u043B \u043D\u043E\u0432\u0443\u044E
      \u0440\u0443\u0441\u0441\u043A\u0443\u044E \u0444\u0440\u0430\u0437\u0443:
      \xAB\u041F\u043E\u0435\u0445\u0430\u043B\u0438!\xBB, \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u044F \u0433\u043E\u0432\u043E\u0440\u044E \u0435\u0451 \u0432\u0441\u0435\u0433\u0434\u0430."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 0f4207d901bd5439cb72a98dd1c63880, type: 3}
