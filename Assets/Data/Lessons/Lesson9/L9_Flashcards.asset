  lessonTitle: "\u0423\u0440\u043E\u043A 9"
  cards:
  - foreignWord: "\u5B66\u4F1A"
    translation: "\u0438\u0437\u0443\u0447\u0430\u0442\u044C-\u0438\u0437\u0443\u0447\u0438\u0442\u044C "
    image: {fileID: 0}
    exampleForeign: 
    exampleTranslation: 
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u89E3\u91CA"
    translation: "\u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C-\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u65B0\u89C4\u5219\u975E\u5E38\u96BE\uFF0C\u4F46\u662F\u6211\u7684\u670B\u53CB\u7ED9\u6211\u89E3\u91CA\u6E05\u695A\u4E86\u3002"
    exampleTranslation: "\u041D\u043E\u0432\u043E\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u043E
      \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u0442\u0440\u0443\u0434\u043D\u044B\u043C,
      \u043D\u043E \u043C\u043E\u0439 \u0434\u0440\u0443\u0433 \u0445\u043E\u0440\u043E\u0448\u043E
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B \u043C\u043D\u0435 \u0435\u0433\u043E."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5B8C\u6210"
    translation: "\u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0442\u044C-\u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: 
    exampleTranslation: 
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5F00\u59CB"
    translation: "\u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C-\u043D\u0430\u0447\u0430\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: 
    exampleTranslation: 
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u89C4\u5219"
    translation: "\u043F\u0440\u0430\u0432\u0438\u043B\u043E"
    image: {fileID: 0}
    exampleForeign: "\u65B0\u89C4\u5219\u975E\u5E38\u96BE\uFF0C\u4F46\u662F\u6211\u7684\u670B\u53CB\u7ED9\u6211\u89E3\u91CA\u6E05\u695A\u4E86\u3002"
    exampleTranslation: "\u041D\u043E\u0432\u043E\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u043E
      \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u0442\u0440\u0443\u0434\u043D\u044B\u043C,
      \u043D\u043E \u043C\u043E\u0439 \u0434\u0440\u0443\u0433 \u0445\u043E\u0440\u043E\u0448\u043E
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B \u043C\u043D\u0435 \u0435\u0433\u043E."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6559\u80B2"
    translation: "\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435"
    image: {fileID: 0}
    exampleForeign: "\u826F\u597D\u7684\u6559\u80B2\u6709\u52A9\u4E8E\u627E\u5230\u6709\u8DA3\u7684\u5DE5\u4F5C\u3002"
    exampleTranslation: "\u0425\u043E\u0440\u043E\u0448\u0435\u0435 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043D\u0430\u0439\u0442\u0438
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u79D1\u76EE"
    translation: "\u043F\u0440\u0435\u0434\u043C\u0435\u0442"
    image: {fileID: 0}
    exampleForeign: "\u6211\u6700\u559C\u6B22\u7684\u5B66\u6821\u79D1\u76EE\u662F\u4FC4\u8BED\uFF0C\u56E0\u4E3A\u6211\u559C\u6B22\u4FC4\u7F57\u65AF\u6587\u5316\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u043B\u044E\u0431\u0438\u043C\u044B\u0439
      \u0448\u043A\u043E\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u2013 \u0440\u0443\u0441\u0441\u043A\u0438\u0439 \u044F\u0437\u044B\u043A,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u044F \u043B\u044E\u0431\u043B\u044E
      \u0440\u0443\u0441\u0441\u043A\u0443\u044E \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0443."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u4E13\u4E1A"
    translation: "\u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u6211\u672A\u6765\u7684\u4E13\u4E1A\u662F\u7FFB\u8BD1\uFF0C\u6240\u4EE5\u6211\u60F3\u5B66\u597D\u4FC4\u8BED\u3002"
    exampleTranslation: "\u041C\u043E\u044F \u0431\u0443\u0434\u0443\u0449\u0430\u044F
      \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u2013 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u0445\u043E\u0447\u0443 \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u0443\u0447\u0438\u0442\u044C
      \u0440\u0443\u0441\u0441\u043A\u0438\u0439 \u044F\u0437\u044B\u043A."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8BB2\u5EA7"
    translation: "\u043B\u0435\u043A\u0446\u0438\u044F"
    image: {fileID: 0}
    exampleForeign: "\u6628\u5929\u5728\u5927\u5B66\u91CC\u6709\u4E00\u573A\u7531\u8457\u540D\u5EFA\u7B51\u5E08\u4E3B\u8BB2\u7684\u5EFA\u7B51\u5B66\u8BB2\u5EA7\uFF0C\u975E\u5E38\u6709\u8DA3\u3002"
    exampleTranslation: "\u0412\u0447\u0435\u0440\u0430 \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0435
      \u0431\u044B\u043B\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430\u044F
      \u043B\u0435\u043A\u0446\u0438\u044F \u043F\u043E \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0435
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
