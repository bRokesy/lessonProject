  m_Script: {fileID: 11500000, guid: e5d41a317c25b604483e6ad55bbda19e, type: 3}
  m_Name: L3_Flashcards
  m_EditorClassIdentifier: Assembly-CSharp::FlashcardDeckData
  lessonTitle: "\u0423\u0440\u043E\u043A 3"
  cards:
  - foreignWord: "\u8DF3\u821E"
    translation: "\u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C-\u043F\u043E\u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C "
    image: {fileID: 0}
    exampleForeign: 
    exampleTranslation: 
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5531"
    translation: "\u043F\u0435\u0442\u044C - \u043F\u043E\u043F\u0435\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: 
    exampleTranslation: 
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u7AE5\u8BDD"
    translation: "\u0441\u043A\u0430\u0437\u043A\u0430"
    image: {fileID: 0}
    exampleForeign: "\u7AE5\u5E74\u65F6\u6BCF\u5929\u665A\u4E0A\u5988\u5988\u7ED9\u6211\u8BB2\u8FC7\u6709\u8DA3\u7684\u7AE5\u8BDD\u3002"
    exampleTranslation: "\u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043C\u0430\u043C\u0430
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430
      \u043C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435
      \u0441\u043A\u0430\u0437\u043A\u0438."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u77ED\u7BC7\u5C0F\u8BF4"
    translation: "\u0440\u0430\u0441\u0441\u043A\u0430\u0437"
    image: {fileID: 0}
    exampleForeign: "\u6628\u5929\u5728\u8BFE\u4E0A\u6211\u4EEC\u8BFB\u4E86\u4E00\u7BC7\u975E\u5E38\u6709\u8DA3\u7684\u5C60\u683C\u6D85\u592B\u7684\u77ED\u7BC7\u5C0F\u8BF4\u3002"
    exampleTranslation: "\u0412\u0447\u0435\u0440\u0430 \u043D\u0430 \u0443\u0440\u043E\u043A\u0435
      \u043C\u044B \u0447\u0438\u0442\u0430\u043B\u0438 \u043E\u0447\u0435\u043D\u044C
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439 \u0440\u0430\u0441\u0441\u043A\u0430\u0437
      \u0422\u0443\u0440\u0433\u0435\u043D\u0435\u0432\u0430"
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u957F\u7BC7\u5C0F\u8BF4"
    translation: "\u0440\u043E\u043C\u0430\u043D"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u670B\u53CB\u6B63\u5728\u8BFB\u4E00\u672C\u5173\u4E8E\u7231\u60C5\u7684\u957F\u7BC7\u5C0F\u8BF4\uFF0C\u5B83\u6709\u4E09\u767E\u591A\u9875\uFF01"
    exampleTranslation: "\u041C\u043E\u044F \u043F\u043E\u0434\u0440\u0443\u0433\u0430
      \u0447\u0438\u0442\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0440\u043E\u043C\u0430\u043D \u043F\u0440\u043E \u043B\u044E\u0431\u043E\u0432\u044C,
      \u0432 \u043D\u0451\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u0440\u0451\u0445\u0441\u043E\u0442
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446!"
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6D6A\u6F2B\u6B4C\u66F2"
    translation: "\u0440\u043E\u043C\u0430\u043D\u0441"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u5976\u5976\u975E\u5E38\u559C\u6B22\u5531\u53E4\u8001\u7684\u6D6A\u6F2B\u6B4C\u66F2\uFF0C\u6211\u4EEC\u975E\u5E38\u4EAB\u53D7\u542C\u5979\u5531\u6B4C\u3002"
    exampleTranslation: "\u041C\u043E\u044F \u0431\u0430\u0431\u0443\u0448\u043A\u0430
      \u043E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u0438\u0442 \u043F\u0435\u0442\u044C
      \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u044B\u0435 \u0440\u043E\u043C\u0430\u043D\u0441\u044B,
      \u0438 \u043C\u044B \u0441\u043B\u0443\u0448\u0430\u0435\u043C \u0435\u0435
      \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u7235\u58EB"
    translation: "\u0434\u0436\u0430\u0437"
    image: {fileID: 0}
    exampleForeign: "\u661F\u671F\u516D\u665A\u4E0A\u6211\u4EEC\u53BB\u4E86\u4FF1\u4E50\u90E8\uFF0C\u542C\u4E86\u7235\u58EB\u4E50\uFF0C\u8FD8\u8DF3\u4E86\u4E00\u4F1A\u513F\u821E\u3002"
    exampleTranslation: "\u0412 \u0441\u0443\u0431\u0431\u043E\u0442\u0443 \u0432\u0435\u0447\u0435\u0440\u043E\u043C
      \u043C\u044B \u043F\u043E\u0448\u043B\u0438 \u0432 \u043A\u043B\u0443\u0431,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C
      \u0434\u0436\u0430\u0437 \u0438 \u043F\u043E\u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C. "
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u4F1A\u6F14"
    translation: "\u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044C"
    image: {fileID: 0}
    exampleForeign: "\u6BCF\u5E74\u79CB\u5929\u6211\u4EEC\u57CE\u5E02\u90FD\u4F1A\u4E3E\u529E\u97F3\u4E50\u8282\uFF0C\u4ECA\u5E74\u6211\u4EEC\u51B3\u5B9A\u53BB\u90A3\u91CC\u8DF3\u821E\u548C\u6563\u6B65\u3002"
    exampleTranslation: "\u041A\u0430\u0436\u0434\u0443\u044E \u043E\u0441\u0435\u043D\u044C
      \u0432 \u043D\u0430\u0448\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0439
      \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044C, \u0438 \u0432 \u044D\u0442\u043E\u043C
      \u0433\u043E\u0434\u0443 \u043C\u044B \u0440\u0435\u0448\u0438\u043B\u0438
      \u043F\u043E\u0439\u0442\u0438 \u0442\u0443\u0434\u0430, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C \u0438 \u043F\u043E\u0433\u0443\u043B\u044F\u0442\u044C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
