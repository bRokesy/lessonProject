  m_Script: {fileID: 11500000, guid: e5d41a317c25b604483e6ad55bbda19e, type: 3}
  m_Name: L2_Flashcards
  m_EditorClassIdentifier: Assembly-CSharp::FlashcardDeckData
  lessonTitle: "\u0423\u0440\u043E\u043A 2"
  cards:
  - foreignWord: "\u95EE\u9898"
    translation: "\u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430"
    image: {fileID: 0}
    exampleForeign: "\u6211\u4E4B\u524D\u6709\u4E2A\u95EE\u9898\uFF1A\u6211\u4E0D\u61C2\u65B0\u89C4\u5219\uFF0C\u4F46\u73B0\u5728\u6211\u5168\u660E\u767D\u4E86\uFF0C\u6211\u6CA1\u6709\u4EFB\u4F55\u95EE\u9898\u4E86\u3002"
    exampleTranslation: "\u0423 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u0430
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430: \u044F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043B
      \u043D\u043E\u0432\u043E\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u043E,
      \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0432\u0441\u0451
      \u043F\u043E\u043D\u044F\u043B \u0438 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C"
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5206\u949F"
    translation: "\u043C\u0438\u043D\u0443\u0442\u0430"
    image: {fileID: 0}
    exampleForeign: "\u7B49\u4E00\u5206\u949F\uFF0C\u6211\u60F3\u7ED9\u5988\u5988\u53D1\u6761\u6D88\u606F\uFF0C\u7136\u540E\u6211\u4EEC\u53BB\u516C\u56ED\u6563\u6B65\u3002"
    exampleTranslation: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438 \u043E\u0434\u043D\u0443
      \u043C\u0438\u043D\u0443\u0442\u0443, \u044F \u0445\u043E\u0447\u0443 \u043F\u043E\u0441\u043B\u0430\u0442\u044C
      \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043C\u0430\u043C\u0435,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u043C\u044B \u043F\u043E\u0439\u0434\u0451\u043C
      \u0433\u0443\u043B\u044F\u0442\u044C \u0432 \u043F\u0430\u0440\u043A."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5C0F\u65F6"
    translation: "\u0447\u0430\u0441"
    image: {fileID: 0}
    exampleForeign: "\u6628\u5929\u6211\u4EEC\u6563\u6B65\u4E86\u4E00\u4E2A\u5C0F\u65F6\uFF0C\u7136\u540E\u6211\u4EEC\u5750\u5728\u5496\u5561\u9986\u91CC\u4F11\u606F\uFF0C\u56E0\u4E3A\u6211\u4EEC\u7D2F\u4E86\u3002"
    exampleTranslation: "\u0412\u0447\u0435\u0440\u0430 \u043C\u044B \u0433\u0443\u043B\u044F\u043B\u0438
      \u043E\u0434\u0438\u043D \u0447\u0430\u0441, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u043C\u044B \u0441\u0438\u0434\u0435\u043B\u0438 \u0432 \u043A\u0430\u0444\u0435
      \u0438 \u043E\u0442\u0434\u044B\u0445\u0430\u043B\u0438, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u043C\u044B \u0443\u0441\u0442\u0430\u043B\u0438."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u804C\u4E1A"
    translation: "\u0437\u0430\u043D\u044F\u0442\u0438\u0435"
    image: {fileID: 0}
    exampleForeign: "\u6211\u6700\u559C\u6B22\u7684\u4E8B\u60C5\u662F\u8BFB\u7AE5\u8BDD\u548C\u77ED\u7BC7\u5C0F\u8BF4\uFF0C\u800C\u6211\u7684\u59B9\u59B9\u559C\u6B22\u5531\u6B4C\u548C\u8DF3\u821E\u3002"
    exampleTranslation: "\u041C\u043E\u0451 \u043B\u044E\u0431\u0438\u043C\u043E\u0435
      \u0437\u0430\u043D\u044F\u0442\u0438\u0435 \u2013 \u044D\u0442\u043E \u0447\u0438\u0442\u0430\u0442\u044C
      \u0441\u043A\u0430\u0437\u043A\u0438 \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B,
      \u0430 \u043C\u043E\u044F \u0441\u0435\u0441\u0442\u0440\u0430 \u043B\u044E\u0431\u0438\u0442
      \u043F\u0435\u0442\u044C \u0438 \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u65F6\u523B"
    translation: "\u043C\u043E\u043C\u0435\u043D\u0442"
    image: {fileID: 0}
    exampleForeign: "\u5728\u6211\u6536\u5230\u670B\u53CB\u6D88\u606F\u7684\u90A3\u4E00\u523B\uFF0C\u6211\u6B63\u5750\u5728\u8BFE\u5802\u4E0A\uFF0C\u6CA1\u6CD5\u56DE\u590D\u3002"
    exampleTranslation: "\u0412 \u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430,
      \u044F \u0441\u0438\u0434\u0435\u043B \u043D\u0430 \u0443\u0440\u043E\u043A\u0435
      \u0438 \u043D\u0435 \u043C\u043E\u0433 \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u4EA7\u54C1/\u98DF\u54C1"
    translation: "\u043F\u0440\u043E\u0434\u0443\u043A\u0442"
    image: {fileID: 0}
    exampleForeign: "\u5728\u5546\u5E97\u91CC\u6211\u4EEC\u4E70\u4E86\u5404\u79CD\u98DF\u54C1\uFF1A\u9762\u5305\u3001\u725B\u5976\u3001\u9E21\u86CB\u548C\u6C34\u679C\u3002"
    exampleTranslation: "\u0412 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435
      \u043C\u044B \u043A\u0443\u043F\u0438\u043B\u0438 \u0440\u0430\u0437\u043D\u044B\u0435
      \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B: \u0445\u043B\u0435\u0431,
      \u043C\u043E\u043B\u043E\u043A\u043E, \u044F\u0439\u0446\u0430 \u0438 \u0444\u0440\u0443\u043A\u0442\u044B."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u4F20\u771F\u673A"
    translation: "\u0444\u0430\u043A\u0441"
    image: {fileID: 0}
    exampleForeign: "\u4EE5\u524D\u6211\u7238\u7238\u7ECF\u5E38\u5F80\u5355\u4F4D\u53D1\u4F20\u771F\uFF0C\u4F46\u73B0\u5728\u4ED6\u53EA\u901A\u8FC7\u624B\u673A\u53D1\u6D88\u606F\u3002"
    exampleTranslation: "\u0420\u0430\u043D\u044C\u0448\u0435 \u043C\u043E\u0439
      \u043F\u0430\u043F\u0430 \u0447\u0430\u0441\u0442\u043E \u043F\u043E\u0441\u044B\u043B\u0430\u043B
      \u0444\u0430\u043A\u0441 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443,
      \u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u043E\u043D \u043F\u043E\u0441\u044B\u043B\u0430\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F
      \u043F\u043E \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u4E8B\u60C5"
    translation: "\u0434\u0435\u043B\u043E"
    image: {fileID: 0}
    exampleForeign: "\u6211\u4ECA\u5929\u6709\u5F88\u591A\u4E8B\u60C5\uFF1A\u9996\u5148\u6211\u5F97\u505A\u5B8C\u4F5C\u4E1A\uFF0C\u7136\u540E\u548C\u72D7\u73A9\u4E00\u4F1A\u513F\uFF0C\u665A\u4E0A\u770B\u7535\u5F71\u3002"
    exampleTranslation: "\u0423 \u043C\u0435\u043D\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043C\u043D\u043E\u0433\u043E \u0434\u0435\u043B: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u044F \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0438\u0433\u0440\u0430\u0442\u044C
      \u0441 \u0441\u043E\u0431\u0430\u043A\u043E\u0439, \u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C
      - \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0444\u0438\u043B\u044C\u043C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u53D1/\u5BC4\u4FE1"
    translation: "\u043F\u043E\u0441\u044B\u043B\u0430\u0442\u044C \u2013 \u043F\u043E\u0441\u043B\u0430\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: 
    exampleTranslation: 
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
