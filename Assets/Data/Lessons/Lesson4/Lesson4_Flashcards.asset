  m_Script: {fileID: 11500000, guid: e5d41a317c25b604483e6ad55bbda19e, type: 3}
  m_Name: Lesson4_Flashcards
  m_EditorClassIdentifier: Assembly-CSharp::FlashcardDeckData
  lessonTitle: "\u0423\u0440\u043E\u043A 2"
  cards:
  - foreignWord: "\u6A59\u5B50"
    translation: "\u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D"
    image: {fileID: 0}
    exampleForeign: "\u6211\u559C\u6B22\u5403\u6A59\u5B50\uFF0C\u6628\u5929\u6211\u4E70\u4E86\u4E09\u4E2A\u5927\u6A59\u5B50\uFF0C\u81EA\u5DF1\u628A\u5B83\u4EEC\u5403\u4E86\u3002"
    exampleTranslation: "\u042F \u043B\u044E\u0431\u043B\u044E \u0435\u0441\u0442\u044C
      \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u044B, \u0430 \u0432\u0447\u0435\u0440\u0430
      \u044F \u043A\u0443\u043F\u0438\u043B \u0442\u0440\u0438 \u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u0430 \u0441\u044A\u0435\u043B
      \u0438\u0445 \u0441\u0430\u043C"
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 00643eb9a6e404e168c8e6815c7895c0, type: 3}
  - foreignWord: "\u4E09\u660E\u6CBB"
    translation: "\u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434"
    image: {fileID: 0}
    exampleForeign: "\u65E9\u9910\u6211\u901A\u5E38\u505A\u5976\u916A\u4E09\u660E\u6CBB\u5E76\u559D\u8336\uFF0C\u800C\u6211\u7684\u54E5\u54E5\u559C\u6B22\u5403\u9999\u80A0\u4E09\u660E\u6CBB\u3002"
    exampleTranslation: "\u041D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A
      \u044F \u043E\u0431\u044B\u0447\u043D\u043E \u0434\u0435\u043B\u0430\u044E
      \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434 \u0441 \u0441\u044B\u0440\u043E\u043C
      \u0438 \u043F\u044C\u044E \u0447\u0430\u0439, \u0430 \u043C\u043E\u0439 \u0431\u0440\u0430\u0442
      \u043B\u044E\u0431\u0438\u0442 \u0435\u0441\u0442\u044C \u0431\u0443\u0442\u0435\u0440\u0431\u0440\u043E\u0434
      \u0441 \u043A\u043E\u043B\u0431\u0430\u0441\u043E\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: d323fa5693506436d994fe42f6ff9c65, type: 3}
  - foreignWord: "\u74F6\u5B50"
    translation: "\u0431\u0443\u0442\u044B\u043B\u043A\u0430"
    image: {fileID: 0}
    exampleForeign: "\u5988\u5988\u8BA9\u6211\u4E70\u4E00\u74F6\u6C34\u548C\u4E00\u74F6\u725B\u5976\uFF0C\u6240\u4EE5\u6211\u5C31\u53BB\u4E86\u5546\u5E97\u3002"
    exampleTranslation: "\u041C\u0430\u043C\u0430 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u043C\u0435\u043D\u044F \u043A\u0443\u043F\u0438\u0442\u044C \u0431\u0443\u0442\u044B\u043B\u043A\u0443
      \u0432\u043E\u0434\u044B \u0438 \u0431\u0443\u0442\u044B\u043B\u043A\u0443
      \u043C\u043E\u043B\u043E\u043A\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u043F\u043E\u0448\u0451\u043B \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 08d56242e2ebb401190e1466520a7a99, type: 3}
  - foreignWord: "\u7CD6\u679C"
    translation: "\u043A\u043E\u043D\u0444\u0435\u0442\u0430"
    image: {fileID: 0}
    exampleForeign: "\u5C0F\u5B69\u5B50\u975E\u5E38\u559C\u6B22\u5403\u7CD6\u679C\uFF0C\u4F46\u4E0D\u80FD\u5403\u592A\u591A\uFF0C\u56E0\u4E3A\u90A3\u6837\u4E0D\u597D\u3002"
    exampleTranslation: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u0434\u0435\u0442\u0438
      \u043E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u044F\u0442 \u0435\u0441\u0442\u044C
      \u043A\u043E\u043D\u0444\u0435\u0442\u044B, \u043D\u043E \u043C\u043D\u043E\u0433\u043E
      \u043A\u043E\u043D\u0444\u0435\u0442 \u0435\u0441\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u044D\u0442\u043E
      \u043F\u043B\u043E\u0445\u043E."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 9ec101e687efd4f28a1ea031aeb79b43, type: 3}
  - foreignWord: "\u836F"
    translation: "\u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E"
    image: {fileID: 0}
    exampleForeign: "\u6211\u751F\u75C5\u7684\u65F6\u5019\uFF0C\u4F1A\u5403\u533B\u751F\u7ED9\u6211\u7684\u836F\uFF0C\u7136\u540E\u5F85\u5728\u5BB6\u91CC\u3002"
    exampleTranslation: "\u041A\u043E\u0433\u0434\u0430 \u044F \u0431\u043E\u043B\u0435\u044E,
      \u044F \u043F\u044C\u044E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0434\u0430\u0451\u0442 \u043C\u043D\u0435
      \u0432\u0440\u0430\u0447, \u0430 \u043F\u043E\u0442\u043E\u043C \u0441\u0438\u0436\u0443
      \u0434\u043E\u043C\u0430."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: a780bd76e74fe4599a71989e69717599, type: 3}
  - foreignWord: "\u86CB\u7CD5"
    translation: "\u0442\u043E\u0440\u0442"
    image: {fileID: 0}
    exampleForeign: "\u661F\u671F\u5929\u662F\u6211\u59B9\u59B9\u7684\u751F\u65E5\uFF0C\u6211\u4EEC\u4F1A\u4E70\u4E00\u4E2A\u5927\u86CB\u7CD5\uFF0C\u5E76\u5531\u300A\u751F\u65E5\u5FEB\u4E50\u300B\u6B4C\u3002"
    exampleTranslation: "\u0412 \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u044C\u0435
      \u0443 \u043C\u043E\u0435\u0439 \u0441\u0435\u0441\u0442\u0440\u044B \u0434\u0435\u043D\u044C
      \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F, \u043C\u044B \u043A\u0443\u043F\u0438\u043C
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u043E\u0440\u0442 \u0438
      \u0431\u0443\u0434\u0435\u043C \u043F\u0435\u0442\u044C \u043F\u0435\u0441\u043D\u044E
      \xAB\u0421 \u0434\u043D\u0451\u043C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F!\xBB"
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 78040bd14b1ad4def891414c6c2ff054, type: 3}
  - foreignWord: "\u89C6\u9891"
    translation: "\u0432\u0438\u0434\u0435\u043E"
    image: {fileID: 0}
    exampleForeign: "\u665A\u4E0A\u6211\u559C\u6B22\u5728\u624B\u673A\u4E0A\u4E0A\u7F51\u770B\u77ED\u89C6\u9891\u3002"
    exampleTranslation: "\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u044F \u043B\u044E\u0431\u043B\u044E
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435
      \u0432\u0438\u0434\u0435\u043E \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435
      \u0432 \u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0435."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: a3f936f3c546042e897415e357febaa7, type: 3}
  - foreignWord: "\u7167\u76F8\u673A"
    translation: "\u0444\u043E\u0442\u043E\u0430\u043F\u043F\u0430\u0440\u0430\u0442"
    image: {fileID: 0}
    exampleForeign: "\u4ED6\u62FF\u8D77\u76F8\u673A\uFF0C\u62CD\u4E0B\u4E86\u7F8E\u4E3D\u7684\u65E5\u843D\u3002"
    exampleTranslation: "\u041E\u043D \u0432\u0437\u044F\u043B \u0444\u043E\u0442\u043E\u0430\u043F\u043F\u0430\u0440\u0430\u0442
      \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u043E\u0432\u0430\u043B
      \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0437\u0430\u043A\u0430\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 8300000, guid: 2b58304ebfd76473db73b8c3c12afff2, type: 3}
