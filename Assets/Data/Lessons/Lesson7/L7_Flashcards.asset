  m_Script: {fileID: 11500000, guid: e5d41a317c25b604483e6ad55bbda19e, type: 3}
  m_Name: L7_Flashcards
  m_EditorClassIdentifier: Assembly-CSharp::FlashcardDeckData
  lessonTitle: "\u0423\u0440\u043E\u043A 7"
  cards:
  - foreignWord: "\u505A\u83DC"
    translation: "\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C-\u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u5976\u5976\u5E38\u505A\u65B0\u9C9C\u852C\u83DC\u6C99\u62C9\uFF0C\u6211\u6709\u65F6\u5F53\u65E9\u9910\u5403\uFF0C\u6709\u65F6\u5F53\u665A\u9910\u5403\u3002"
    exampleTranslation: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0447\u0430\u0441\u0442\u043E
      \u0433\u043E\u0442\u043E\u0432\u0438\u0442 \u0441\u0430\u043B\u0430\u0442 \u0438\u0437
      \u0441\u0432\u0435\u0436\u0438\u0445 \u043E\u0432\u043E\u0449\u0435\u0439,
      \u0430 \u044F \u0435\u043C \u0435\u0433\u043E \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A
      \u0438\u043B\u0438 \u0443\u0436\u0438\u043D\u0430\u044E \u0438\u043C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8BA2"
    translation: "\u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C-\u0437\u0430\u043A\u0430\u0437\u0430\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u53D4\u53D4\u559C\u6B22\u5728\u9910\u5385\u5403\u665A\u996D\uFF0C\u4ED6\u5E38\u70B9\u8089\u548C\u7EA2\u9152\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0434\u044F\u0434\u044F \u043B\u044E\u0431\u0438\u0442
      \u0443\u0436\u0438\u043D\u0430\u0442\u044C \u0432 \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0435,
      \u043E\u043D \u0447\u0430\u0441\u0442\u043E \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043C\u044F\u0441\u043E \u0438 \u043A\u0440\u0430\u0441\u043D\u043E\u0435
      \u0432\u0438\u043D\u043E."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8461\u8404\u9152"
    translation: "\u0432\u0438\u043D\u043E"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u53D4\u53D4\u559C\u6B22\u5728\u9910\u5385\u5403\u665A\u996D\uFF0C\u4ED6\u5E38\u70B9\u8089\u548C\u7EA2\u9152\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0434\u044F\u0434\u044F \u043B\u044E\u0431\u0438\u0442
      \u0443\u0436\u0438\u043D\u0430\u0442\u044C \u0432 \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0435,
      \u043E\u043D \u0447\u0430\u0441\u0442\u043E \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043C\u044F\u0441\u043E \u0438 \u043A\u0440\u0430\u0441\u043D\u043E\u0435
      \u0432\u0438\u043D\u043E."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6D3E"
    translation: "\u043F\u0438\u0440\u043E\u0436\u043D\u043E\u0435"
    image: {fileID: 0}
    exampleForeign: "\u661F\u671F\u516D\u6211\u548C\u670B\u53CB\u5728\u5496\u5561\u9986\u5403\u4E86\u5348\u996D\uFF0C\u70B9\u4E86\u4E24\u5757\u86CB\u7CD5\uFF0C\u56E0\u4E3A\u6211\u4EEC\u60F3\u5C1D\u4E00\u5C1D\u3002"
    exampleTranslation: "\u0412 \u0441\u0443\u0431\u0431\u043E\u0442\u0443 \u043C\u044B
      \u0441 \u043F\u043E\u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u043E\u043E\u0431\u0435\u0434\u0430\u043B\u0438
      \u0432 \u043A\u0430\u0444\u0435 \u0438 \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0438
      \u0434\u0432\u0430 \u043F\u0438\u0440\u043E\u0436\u043D\u044B\u0445, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0445\u043E\u0442\u0435\u043B\u0438 \u0438\u0445 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6C99\u62C9"
    translation: "\u0441\u0430\u043B\u0430\u0442"
    image: {fileID: 0}
    exampleForeign: "\u5976\u5976\u5E38\u505A\u65B0\u9C9C\u852C\u83DC\u6C99\u62C9\uFF0C\u6211\u6709\u65F6\u5F53\u65E9\u9910\u5403\uFF0C\u6709\u65F6\u5F53\u665A\u9910\u5403\u3002"
    exampleTranslation: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u0447\u0430\u0441\u0442\u043E
      \u0433\u043E\u0442\u043E\u0432\u0438\u0442 \u0441\u0430\u043B\u0430\u0442 \u0438\u0437
      \u0441\u0432\u0435\u0436\u0438\u0445 \u043E\u0432\u043E\u0449\u0435\u0439,
      \u0430 \u044F \u0435\u043C \u0435\u0433\u043E \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A
      \u0438\u043B\u0438 \u0443\u0436\u0438\u043D\u0430\u044E \u0438\u043C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5DE7\u514B\u529B"
    translation: "\u0448\u043E\u043A\u043E\u043B\u0430\u0434"
    image: {fileID: 0}
    exampleForeign: "\u5F1F\u5F1F\u8BA9\u6211\u4E70\u5DE7\u514B\u529B\uFF0C\u4F46\u6211\u5148\u5403\u4E86\u5348\u996D\uFF0C\u7136\u540E\u6211\u4EEC\u4E00\u8D77\u628A\u5B83\u5403\u4E86\u3002"
    exampleTranslation: "\u041C\u043B\u0430\u0434\u0448\u0438\u0439 \u0431\u0440\u0430\u0442
      \u0441\u043A\u0430\u0437\u0430\u043B \u043C\u043D\u0435 \u043A\u0443\u043F\u0438\u0442\u044C
      \u0448\u043E\u043A\u043E\u043B\u0430\u0434, \u043D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u044F \u043F\u043E\u043E\u0431\u0435\u0434\u0430\u043B, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u043C\u044B \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u044A\u0435\u043B\u0438
      \u0435\u0433\u043E."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6C7D\u6C34"
    translation: "\u043B\u0438\u043C\u043E\u043D\u0430\u0434"
    image: {fileID: 0}
    exampleForeign: "\u6628\u5929\u5728\u91CE\u9910\u65F6\u6211\u4EEC\u70B9\u4E86\u6BD4\u8428\u997C\u548C\u67E0\u6AAC\u6C34\uFF0C\u559D\u4E86\u4E00\u6574\u74F6\uFF0C\u8FD8\u5C1D\u4E86\u51B0\u6DC7\u6DCB\u3002"
    exampleTranslation: "\u0412\u0447\u0435\u0440\u0430 \u043D\u0430 \u043F\u0438\u043A\u043D\u0438\u043A\u0435
      \u043C\u044B \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0438 \u043F\u0438\u0446\u0446\u0443
      \u0438 \u043B\u0438\u043C\u043E\u043D\u0430\u0434, \u0432\u044B\u043F\u0438\u043B\u0438
      \u0446\u0435\u043B\u0443\u044E \u0431\u0443\u0442\u044B\u043B\u043A\u0443 \u0438
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0438 \u0435\u0449\u0451
      \u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043E\u0435."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u83DC\u5355"
    translation: "\u043C\u0435\u043D\u044E"
    image: {fileID: 0}
    exampleForeign: "\u6211\u4EEC\u5230\u9910\u5385\u540E\uFF0C\u670D\u52A1\u5458\u7ED9\u4E86\u6211\u4EEC\u83DC\u5355\uFF0C\u6211\u4EEC\u9009\u4E86\u5F88\u957F\u65F6\u95F4\u624D\u51B3\u5B9A\u665A\u9910\u70B9\u4EC0\u4E48\u3002"
    exampleTranslation: "\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u043F\u0440\u0438\u0448\u043B\u0438
      \u0432 \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D, \u043E\u0444\u0438\u0446\u0438\u0430\u043D\u0442
      \u0434\u0430\u043B \u043D\u0430\u043C \u043C\u0435\u043D\u044E, \u0438 \u043C\u044B
      \u0434\u043E\u043B\u0433\u043E \u0432\u044B\u0431\u0438\u0440\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0437\u0430\u043A\u0430\u0437\u0430\u0442\u044C \u043D\u0430
      \u0443\u0436\u0438\u043D."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5473\u9053"
    translation: "\u0432\u043A\u0443\u0441"
    image: {fileID: 0}
    exampleForeign: "\u6211\u975E\u5E38\u559C\u6B22\u65B0\u9C9C\u9762\u5305\u7684\u5473\u9053\uFF0C\u6240\u4EE5\u6211\u5E38\u628A\u5B83\u5F53\u65E9\u9910\uFF0C\u518D\u559D\u70B9\u725B\u5976\u3002"
    exampleTranslation: "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u0432\u043A\u0443\u0441 \u0441\u0432\u0435\u0436\u0435\u0433\u043E \u0445\u043B\u0435\u0431\u0430,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0447\u0430\u0441\u0442\u043E
      \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430\u044E \u0438\u043C \u0438
      \u043F\u044C\u044E \u043C\u043E\u043B\u043E\u043A\u043E."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
