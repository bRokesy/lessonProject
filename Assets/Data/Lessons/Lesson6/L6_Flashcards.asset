  m_Script: {fileID: 11500000, guid: e5d41a317c25b604483e6ad55bbda19e, type: 3}
  m_Name: L6_Flashcards
  m_EditorClassIdentifier: Assembly-CSharp::FlashcardDeckData
  lessonTitle: "\u0423\u0440\u043E\u043A 6"
  cards:
  - foreignWord: "\u6563\u6B65/\u73A9"
    translation: "\u0433\u0443\u043B\u044F\u0442\u044C-\u043F\u043E\u0433\u0443\u043B\u044F\u0442\u044C "
    image: {fileID: 0}
    exampleForeign: "\u6211\u5BB6\u9644\u8FD1\u6709\u4E00\u4E2A\u6F02\u4EAE\u7684\u8857\u5FC3\u516C\u56ED\uFF0C\u6211\u4EEC\u559C\u6B22\u5728\u90A3\u91CC\u905B\u72D7\u3002"
    exampleTranslation: "\u0420\u044F\u0434\u043E\u043C \u0441 \u043C\u043E\u0438\u043C
      \u0434\u043E\u043C\u043E\u043C \u0435\u0441\u0442\u044C \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439
      \u0441\u043A\u0432\u0435\u0440, \u0433\u0434\u0435 \u043C\u044B \u043B\u044E\u0431\u0438\u043C
      \u0433\u0443\u043B\u044F\u0442\u044C \u0441 \u0441\u043E\u0431\u0430\u043A\u043E\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u4F11\u606F"
    translation: "\u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C-\u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C  "
    image: {fileID: 0}
    exampleForeign: "\u5B66\u6821\u65C1\u8FB9\u6709\u4E00\u4E2A\u6F02\u4EAE\u7684\u8857\u5FC3\u516C\u56ED\uFF0C\u4EBA\u4EEC\u559C\u6B22\u5728\u90A3\u91CC\u6563\u6B65\u548C\u4F11\u606F\u3002"
    exampleTranslation: "\u0420\u044F\u0434\u043E\u043C \u0441\u043E \u0448\u043A\u043E\u043B\u043E\u0439
      \u0435\u0441\u0442\u044C \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0441\u043A\u0432\u0435\u0440,
      \u0433\u0434\u0435 \u043B\u044E\u0434\u0438 \u043B\u044E\u0431\u044F\u0442
      \u0433\u0443\u043B\u044F\u0442\u044C \u0438 \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8857\u5FC3\u516C\u56ED"
    translation: "\u0441\u043A\u0432\u0435\u0440 "
    image: {fileID: 0}
    exampleForeign: "\u5B66\u6821\u65C1\u8FB9\u6709\u4E00\u4E2A\u6F02\u4EAE\u7684\u8857\u5FC3\u516C\u56ED\uFF0C\u4EBA\u4EEC\u559C\u6B22\u5728\u90A3\u91CC\u6563\u6B65\u548C\u4F11\u606F\u3002"
    exampleTranslation: "\u0420\u044F\u0434\u043E\u043C \u0441\u043E \u0448\u043A\u043E\u043B\u043E\u0439
      \u0435\u0441\u0442\u044C \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0441\u043A\u0432\u0435\u0440,
      \u0433\u0434\u0435 \u043B\u044E\u0434\u0438 \u043B\u044E\u0431\u044F\u0442
      \u0433\u0443\u043B\u044F\u0442\u044C \u0438 \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u4F11\u606F/\u653E"
    translation: "\u043E\u0442\u0434\u044B\u0445 "
    image: {fileID: 0}
    exampleForeign: "\u590F\u5929\u6211\u4EEC\u4F1A\u53BB\u6E56\u8FB9\uFF0C\u56E0\u4E3A\u90A3\u662F\u5BF9\u5168\u5BB6\u4EBA\u6765\u8BF4\u6700\u597D\u7684\u4F11\u606F\uFF01"
    exampleTranslation: "\u041B\u0435\u0442\u043E\u043C \u043C\u044B \u043F\u043E\u0435\u0434\u0435\u043C
      \u043A \u043E\u0437\u0435\u0440\u0443, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u044D\u0442\u043E \u043B\u0443\u0447\u0448\u0438\u0439
      \u043E\u0442\u0434\u044B\u0445 \u0434\u043B\u044F \u0432\u0441\u0435\u0439
      \u0441\u0435\u043C\u044C\u0438!"
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u533B\u9662"
    translation: "\u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430 "
    image: {fileID: 0}
    exampleForeign: "\u6211\u670B\u53CB\u6628\u5929\u4ECE\u533B\u9662\u7ED9\u6211\u53D1\u4E86\u4E00\u6761\u6D88\u606F\u3002\u4ED6\u8BF4\u4ED6\u6CA1\u6709\u95EE\u9898\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0434\u0440\u0443\u0433 \u0432\u0447\u0435\u0440\u0430
      \u043F\u043E\u0441\u043B\u0430\u043B \u043C\u043D\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435
      \u0438\u0437 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u044B. \u041E\u043D
      \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0443 \u043D\u0435\u0433\u043E
      \u043D\u0435\u0442 \u043F\u0440\u043E\u0431\u043B\u0435\u043C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5CB8\u8FB9"
    translation: "\u043D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u0430\u044F "
    image: {fileID: 0}
    exampleForeign: "\u5728\u5CB8\u8FB9\u6211\u4EEC\u4F34\u7740\u7235\u58EB\u4E50\u8DF3\u821E\uFF0C\u7136\u540E\u5750\u7740\u770B\u65E5\u843D\u3002"
    exampleTranslation: "\u041D\u0430 \u043D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u043E\u0439
      \u043C\u044B \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u043B\u0438 \u043F\u043E\u0434
      \u0434\u0436\u0430\u0437, \u0430 \u043F\u043E\u0442\u043E\u043C \u0441\u0438\u0434\u0435\u043B\u0438
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043D\u0430 \u0437\u0430\u043A\u0430\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u82B1\u56ED"
    translation: "\u0441\u0430\u0434 "
    image: {fileID: 0}
    exampleForeign: "\u6211\u4EEC\u7684\u82B1\u56ED\u91CC\u957F\u7740\u82B1\uFF0C\u6BCF\u5929\u65E9\u6668\u6211\u548C\u5976\u5976\u4E00\u8D77\u5728\u90A3\u91CC\u6563\u6B65\u3002"
    exampleTranslation: "\u0412 \u043D\u0430\u0448\u0435\u043C \u0441\u0430\u0434\u0443
      \u0440\u0430\u0441\u0442\u0443\u0442 \u0446\u0432\u0435\u0442\u044B, \u0438
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0443\u0442\u0440\u043E \u044F \u0433\u0443\u043B\u044F\u044E
      \u0442\u0430\u043C \u0432\u043C\u0435\u0441\u0442\u0435 \u0441\u043E \u0441\u0432\u043E\u0435\u0439
      \u0431\u0430\u0431\u0443\u0448\u043A\u043E\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u9662\u5B50"
    translation: "\u0434\u0432\u043E\u0440 "
    image: {fileID: 0}
    exampleForeign: "\u4F53\u80B2\u573A\u4E0A\u901A\u5E38\u6709\u5F88\u591A\u4EBA\uFF0C\u6240\u4EE5\u6211\u4EEC\u5C31\u5728\u9662\u5B50\u91CC\u8E22\u4E86\u8DB3\u7403\u3002"
    exampleTranslation: "\u041D\u0430 \u0441\u0442\u0430\u0434\u0438\u043E\u043D\u0435
      \u043E\u0431\u044B\u0447\u043D\u043E \u043C\u043D\u043E\u0433\u043E \u043B\u044E\u0434\u0435\u0439,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043C\u044B \u0438\u0433\u0440\u0430\u043B\u0438
      \u0432 \u0444\u0443\u0442\u0431\u043E\u043B \u0432\u043E \u0434\u0432\u043E\u0440\u0435."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
