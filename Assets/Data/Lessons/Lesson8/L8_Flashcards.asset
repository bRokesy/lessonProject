  m_Script: {fileID: 11500000, guid: e5d41a317c25b604483e6ad55bbda19e, type: 3}
  m_Name: L8_Flashcards
  m_EditorClassIdentifier: Assembly-CSharp::FlashcardDeckData
  lessonTitle: "\u0423\u0440\u043E\u043A 8"
  cards:
  - foreignWord: "\u73A9/\u6253"
    translation: "\u0438\u0433\u0440\u0430\u0442\u044C - \u043F\u043E\u0438\u0433\u0440\u0430\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u54E5\u54E5\u4E2A\u5B50\u9AD8\uFF0C\u6240\u4EE5\u4ED6\u7BEE\u7403\u6253\u5F97\u5F88\u597D\uFF0C\u800C\u4E14\u7ECF\u5E38\u8D62\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0431\u0440\u0430\u0442 \u0432\u044B\u0441\u043E\u043A\u0438\u0439,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D \u0445\u043E\u0440\u043E\u0448\u043E
      \u0438\u0433\u0440\u0430\u0435\u0442 \u0432 \u0431\u0430\u0441\u043A\u0435\u0442\u0431\u043E\u043B
      \u0438 \u043E\u0447\u0435\u043D\u044C \u0447\u0430\u0441\u0442\u043E \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8D62"
    translation: "\u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u044C-\u0432\u044B\u0438\u0433\u0440\u0430\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u54E5\u54E5\u4E2A\u5B50\u9AD8\uFF0C\u6240\u4EE5\u4ED6\u7BEE\u7403\u6253\u5F97\u5F88\u597D\uFF0C\u800C\u4E14\u7ECF\u5E38\u8D62\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0431\u0440\u0430\u0442 \u0432\u044B\u0441\u043E\u043A\u0438\u0439,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D \u0445\u043E\u0440\u043E\u0448\u043E
      \u0438\u0433\u0440\u0430\u0435\u0442 \u0432 \u0431\u0430\u0441\u043A\u0435\u0442\u0431\u043E\u043B
      \u0438 \u043E\u0447\u0435\u043D\u044C \u0447\u0430\u0441\u0442\u043E \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8F93"
    translation: "\u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u044C
      - \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u670B\u53CB\u6709\u65F6\u6253\u7F51\u7403\u4F1A\u8F93\uFF0C\u4F46\u4ED6\u5E76\u4E0D\u96BE\u8FC7\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0434\u0440\u0443\u0433 \u0438\u043D\u043E\u0433\u0434\u0430
      \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442 \u0432 \u0442\u0435\u043D\u043D\u0438\u0441,
      \u043D\u043E \u043E\u043D \u043D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u7F51\u7403"
    translation: "\u0442\u0435\u043D\u043D\u0438\u0441"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u670B\u53CB\u6709\u65F6\u6253\u7F51\u7403\u4F1A\u8F93\uFF0C\u4F46\u4ED6\u5E76\u4E0D\u96BE\u8FC7\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0434\u0440\u0443\u0433 \u0438\u043D\u043E\u0433\u0434\u0430
      \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442 \u0432 \u0442\u0435\u043D\u043D\u0438\u0441,
      \u043D\u043E \u043E\u043D \u043D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u7BEE\u7403"
    translation: "\u0431\u0430\u0441\u043A\u0435\u0442\u0431\u043E\u043B"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u54E5\u54E5\u4E2A\u5B50\u9AD8\uFF0C\u6240\u4EE5\u4ED6\u7BEE\u7403\u6253\u5F97\u5F88\u597D\uFF0C\u800C\u4E14\u7ECF\u5E38\u8D62\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0431\u0440\u0430\u0442 \u0432\u044B\u0441\u043E\u043A\u0438\u0439,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D \u0445\u043E\u0440\u043E\u0448\u043E
      \u0438\u0433\u0440\u0430\u0435\u0442 \u0432 \u0431\u0430\u0441\u043A\u0435\u0442\u0431\u043E\u043B
      \u0438 \u043E\u0447\u0435\u043D\u044C \u0447\u0430\u0441\u0442\u043E \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u51B0\u7403"
    translation: "\u0445\u043E\u043A\u043A\u0435\u0439"
    image: {fileID: 0}
    exampleForeign: "\u51AC\u5929\u6211\u548C\u7238\u7238\u4E00\u8D77\u5728\u7535\u89C6\u4E0A\u770B\u51B0\u7403\u6BD4\u8D5B\uFF0C\u800C\u6211\u7684\u7237\u7237\u5E74\u8F7B\u65F6\u81EA\u5DF1\u4E5F\u6253\u8FC7\u51B0\u7403\u3002"
    exampleTranslation: "\u0417\u0438\u043C\u043E\u0439 \u043C\u044B \u0441 \u043F\u0430\u043F\u043E\u0439
      \u0441\u043C\u043E\u0442\u0440\u0438\u043C \u0445\u043E\u043A\u043A\u0435\u0439
      \u043F\u043E \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440\u0443,
      \u0430 \u043C\u043E\u0439 \u0434\u0435\u0434\u0443\u0448\u043A\u0430 \u0432
      \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438 \u0441\u0430\u043C \u0438\u0433\u0440\u0430\u043B
      \u0432 \u0445\u043E\u043A\u043A\u0435\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8FD0\u52A8\u961F"
    translation: "\u043A\u043E\u043C\u0430\u043D\u0434\u0430"
    image: {fileID: 0}
    exampleForeign: "\u6211\u4EEC\u7684\u8DB3\u7403\u961F\u6709\u5341\u540D\u7403\u5458\uFF0C\u6559\u7EC3\u8BF4\u6700\u91CD\u8981\u7684\u662F\u4E00\u8D77\u8E22\u7403\u3002"
    exampleTranslation: "\u0412 \u043D\u0430\u0448\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435
      \u043F\u043E \u0444\u0443\u0442\u0431\u043E\u043B\u0443 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0438\u0433\u0440\u043E\u043A\u043E\u0432, \u0438 \u0442\u0440\u0435\u043D\u0435\u0440
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0435
      \u2013 \u0438\u0433\u0440\u0430\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u73A9\u5177"
    translation: "\u0438\u0433\u0440\u0443\u0448\u043A\u0430"
    image: {fileID: 0}
    exampleForeign: "\u5C0F\u5F1F\u5F1F\u4E0D\u559C\u6B22\u8FD0\u52A8\uFF0C\u4ED6\u53EA\u559C\u6B22\u73A9\u81EA\u5DF1\u7684\u73A9\u5177\u3002"
    exampleTranslation: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0431\u0440\u0430\u0442
      \u043D\u0435 \u043B\u044E\u0431\u0438\u0442 \u0441\u043F\u043E\u0440\u0442,
      \u043E\u043D \u043B\u044E\u0431\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0438\u0433\u0440\u0430\u0442\u044C \u0441\u043E \u0441\u0432\u043E\u0435\u0439
      \u0438\u0433\u0440\u0443\u0448\u043A\u043E\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
