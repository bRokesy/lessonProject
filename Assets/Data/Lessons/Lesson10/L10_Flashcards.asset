  lessonTitle: "\u0423\u0440\u043E\u043A 10"
  cards:
  - foreignWord: "\u51FA\u53BB"
    translation: "\u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C-\u0432\u044B\u0439\u0442\u0438 "
    image: {fileID: 0}
    exampleForeign: "\u6211\u4EEC\u5728\u706B\u8F66\u7AD9\u4E0A\u4E86\u706B\u8F66\uFF0C\u4E24\u4E2A\u5C0F\u65F6\u540E\u5728\u4E00\u4E2A\u5C0F\u57CE\u5E02\u4E0B\u4E86\u8F66\uFF0C\u7136\u540E\u53BB\u6CB3\u8FB9\u6563\u6B65\u3002"
    exampleTranslation: "\u041C\u044B \u0441\u0435\u043B\u0438 \u0432 \u043F\u043E\u0435\u0437\u0434
      \u043D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u0435, \u0430 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430 \u0432\u044B\u0448\u043B\u0438
      \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0438 \u043F\u043E\u0448\u043B\u0438 \u0433\u0443\u043B\u044F\u0442\u044C
      \u043F\u043E \u043D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u043E\u0439"
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5750\u4E0A"
    translation: "\u0441\u0430\u0434\u0438\u0442\u044C\u0441\u044F-\u0441\u0435\u0441\u0442\u044C "
    image: {fileID: 0}
    exampleForeign: "\u6211\u4EEC\u5728\u706B\u8F66\u7AD9\u4E0A\u4E86\u706B\u8F66\uFF0C\u4E24\u4E2A\u5C0F\u65F6\u540E\u5728\u4E00\u4E2A\u5C0F\u57CE\u5E02\u4E0B\u4E86\u8F66\uFF0C\u7136\u540E\u53BB\u6CB3\u8FB9\u6563\u6B65\u3002"
    exampleTranslation: "\u041C\u044B \u0441\u0435\u043B\u0438 \u0432 \u043F\u043E\u0435\u0437\u0434
      \u043D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u0435, \u0430 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430 \u0432\u044B\u0448\u043B\u0438
      \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0438 \u043F\u043E\u0448\u043B\u0438 \u0433\u0443\u043B\u044F\u0442\u044C
      \u043F\u043E \u043D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u043E\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8D76\u5F97\u4E0A"
    translation: "\u0443\u0441\u043F\u0435\u0432\u0430\u0442\u044C-\u0443\u0441\u043F\u0435\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u6BCF\u5929\u65E9\u4E0A\u6211\u90FD\u4F1A\u53EB\u51FA\u79DF\u8F66\uFF0C\u4E3A\u4E86\u80FD\u51C6\u65F6\u8D76\u4E0A\u4E0A\u73ED\u3002"
    exampleTranslation: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0443\u0442\u0440\u043E
      \u044F \u0432\u044B\u0437\u044B\u0432\u0430\u044E \u0442\u0430\u043A\u0441\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u043F\u0435\u0442\u044C \u043D\u0430
      \u0440\u0430\u0431\u043E\u0442\u0443."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u53EB"
    translation: "\u0432\u044B\u0437\u044B\u0432\u0430\u0442\u044C-\u0432\u044B\u0437\u0432\u0430\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u6BCF\u5929\u65E9\u4E0A\u6211\u90FD\u4F1A\u53EB\u51FA\u79DF\u8F66\uFF0C\u4E3A\u4E86\u80FD\u51C6\u65F6\u8D76\u4E0A\u4E0A\u73ED\u3002"
    exampleTranslation: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0443\u0442\u0440\u043E
      \u044F \u0432\u044B\u0437\u044B\u0432\u0430\u044E \u0442\u0430\u043A\u0441\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u043F\u0435\u0442\u044C \u043D\u0430
      \u0440\u0430\u0431\u043E\u0442\u0443."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u51FA\u79DF\u8F66"
    translation: "\u0442\u0430\u043A\u0441\u0438"
    image: {fileID: 0}
    exampleForeign: "\u6BCF\u5929\u65E9\u4E0A\u6211\u90FD\u4F1A\u53EB\u51FA\u79DF\u8F66\uFF0C\u4E3A\u4E86\u80FD\u51C6\u65F6\u8D76\u4E0A\u4E0A\u73ED\u3002"
    exampleTranslation: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0443\u0442\u0440\u043E
      \u044F \u0432\u044B\u0437\u044B\u0432\u0430\u044E \u0442\u0430\u043A\u0441\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u043F\u0435\u0442\u044C \u043D\u0430
      \u0440\u0430\u0431\u043E\u0442\u0443."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u706B\u8F66"
    translation: "\u043F\u043E\u0435\u0437\u0434"
    image: {fileID: 0}
    exampleForeign: "\u6211\u4EEC\u5728\u706B\u8F66\u7AD9\u4E0A\u4E86\u706B\u8F66\uFF0C\u4E24\u4E2A\u5C0F\u65F6\u540E\u5728\u4E00\u4E2A\u5C0F\u57CE\u5E02\u4E0B\u4E86\u8F66\uFF0C\u7136\u540E\u53BB\u6CB3\u8FB9\u6563\u6B65\u3002"
    exampleTranslation: "\u041C\u044B \u0441\u0435\u043B\u0438 \u0432 \u043F\u043E\u0435\u0437\u0434
      \u043D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u0435, \u0430 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430 \u0432\u044B\u0448\u043B\u0438
      \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0438 \u043F\u043E\u0448\u043B\u0438 \u0433\u0443\u043B\u044F\u0442\u044C
      \u043F\u043E \u043D\u0430\u0431\u0435\u0440\u0435\u0436\u043D\u043E\u0439."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5730\u94C1"
    translation: "\u043C\u0435\u0442\u0440\u043E"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u670B\u53CB\u4F4F\u5F97\u5F88\u8FDC\uFF0C\u6240\u4EE5\u4ED6\u6BCF\u5929\u90FD\u5750\u5730\u94C1\uFF0C\u5750\u4E8C\u5341\u5206\u949F\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0434\u0440\u0443\u0433 \u0436\u0438\u0432\u0451\u0442
      \u0434\u0430\u043B\u0435\u043A\u043E, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043E\u043D \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C
      \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u0432 \u043C\u0435\u0442\u0440\u043E
      \u0438 \u0435\u0434\u0435\u0442 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043C\u0438\u043D\u0443\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u706B\u8F66\u7AD9"
    translation: "\u0432\u043E\u043A\u0437\u0430\u043B"
    image: {fileID: 0}
    exampleForeign: "\u6628\u5929\u6211\u4EEC\u5728\u706B\u8F66\u53D1\u8F66\u524D\u4E00\u5C0F\u65F6\u5C31\u5230\u4E86\u706B\u8F66\u7AD9\uFF0C\u56E0\u4E3A\u6211\u4EEC\u6015\u6765\u4E0D\u53CA\u3002"
    exampleTranslation: "\u0412\u0447\u0435\u0440\u0430 \u043C\u044B \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438
      \u043D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B \u0437\u0430 \u0447\u0430\u0441
      \u0434\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u043F\u043E\u0435\u0437\u0434\u0430, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0431\u043E\u044F\u043B\u0438\u0441\u044C \u043D\u0435
      \u0443\u0441\u043F\u0435\u0442\u044C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u98DE\u673A\u573A"
    translation: "\u0430\u044D\u0440\u043E\u043F\u043E\u0440\u0442"
    image: {fileID: 0}
    exampleForeign: "\u4E3A\u4E86\u80FD\u8D76\u4E0A\u98DE\u673A\uFF0C\u6211\u4EEC\u53EB\u4E86\u51FA\u79DF\u8F66\uFF0C\u7136\u540E\u53BB\u4E86\u673A\u573A\u3002"
    exampleTranslation: "\u0427\u0442\u043E\u0431\u044B \u0443\u0441\u043F\u0435\u0442\u044C
      \u043D\u0430 \u0441\u0430\u043C\u043E\u043B\u0451\u0442, \u043C\u044B \u0432\u044B\u0437\u0432\u0430\u043B\u0438
      \u0442\u0430\u043A\u0441\u0438 \u0438 \u043F\u043E\u0435\u0445\u0430\u043B\u0438
      \u0432 \u0430\u044D\u0440\u043E\u043F\u043E\u0440\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8DEF\u7EBF"
    translation: "\u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    image: {fileID: 0}
    exampleForeign: "\u6211\u4EEC\u9009\u62E9\u4E86\u4ECE\u706B\u8F66\u7AD9\u5230\u535A\u7269\u9986\u7684\u6700\u77ED\u8DEF\u7EBF\u3002"
    exampleTranslation: "\u041C\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438
      \u0441\u0430\u043C\u044B\u0439 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u043E\u0442 \u0432\u043E\u043A\u0437\u0430\u043B\u0430
      \u0434\u043E \u043C\u0443\u0437\u0435\u044F."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
