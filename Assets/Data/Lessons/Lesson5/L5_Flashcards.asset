  m_Script: {fileID: 11500000, guid: e5d41a317c25b604483e6ad55bbda19e, type: 3}
  m_Name: L5_Flashcards
  m_EditorClassIdentifier: Assembly-CSharp::FlashcardDeckData
  lessonTitle: 
  cards:
  - foreignWord: "\u770B"
    translation: "\u0432\u0438\u0434\u0435\u0442\u044C-\u0443\u0432\u0438\u0434\u0435\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: "\u6628\u5929\u6211\u548C\u670B\u53CB\u53BB\u4E86\u6CB3\u8FB9\uFF0C\u56E0\u4E3A\u60F3\u770B\u65E5\u843D\u3002"
    exampleTranslation: "\u0412\u0447\u0435\u0440\u0430 \u043C\u044B \u0441 \u0434\u0440\u0443\u0433\u043E\u043C
      \u043F\u043E\u0435\u0445\u0430\u043B\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433
      \u0440\u0435\u043A\u0438, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
      \u0445\u043E\u0442\u0435\u043B\u0438 \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0437\u0430\u043A\u0430\u0442."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6253\u7535\u8BDD"
    translation: "\u0437\u0432\u043E\u043D\u0438\u0442\u044C-\u043F\u043E\u0437\u0432\u043E\u043D\u0438\u0442\u044C"
    image: {fileID: 0}
    exampleForeign: 
    exampleTranslation: 
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u8BA4\u8BC6"
    translation: "\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F-\u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F "
    image: {fileID: 0}
    exampleForeign: "\u590F\u5929\u6211\u53BB\u5976\u5976\u7684\u6751\u5B50\uFF0C\u5728\u90A3\u91CC\u8BA4\u8BC6\u5979\u7684\u90BB\u5C45\u3002"
    exampleTranslation: "\u041B\u0435\u0442\u043E\u043C \u044F \u043F\u043E\u0435\u0434\u0443
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u043A \u0431\u0430\u0431\u0443\u0448\u043A\u0435
      \u0438 \u0442\u0430\u043C \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u043B\u044E\u0441\u044C
      \u0441 \u0435\u0435 \u0441\u043E\u0441\u0435\u0434\u043E\u043C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6CB3\u8FB9"
    translation: "\u0431\u0435\u0440\u0435\u0433 "
    image: {fileID: 0}
    exampleForeign: 
    exampleTranslation: 
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6751\u8F6C"
    translation: "\u0434\u0435\u0440\u0435\u0432\u043D\u044F "
    image: {fileID: 0}
    exampleForeign: "\u590F\u5929\u6211\u53BB\u5976\u5976\u7684\u6751\u5B50\uFF0C\u5728\u90A3\u91CC\u8BA4\u8BC6\u5979\u7684\u90BB\u5C45\u3002"
    exampleTranslation: "\u041B\u0435\u0442\u043E\u043C \u044F \u043F\u043E\u0435\u0434\u0443
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u043A \u0431\u0430\u0431\u0443\u0448\u043A\u0435
      \u0438 \u0442\u0430\u043C \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u043B\u044E\u0441\u044C
      \u0441 \u0435\u0435 \u0441\u043E\u0441\u0435\u0434\u043E\u043C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u753B\u5ECA"
    translation: "\u0433\u0430\u043B\u0435\u0440\u0435\u044F "
    image: {fileID: 0}
    exampleForeign: "\u661F\u671F\u516D\u6211\u548C\u5988\u5988\u53BB\u753B\u5ECA\u770B\u65B0\u753B\u3002"
    exampleTranslation: "\u0412 \u0441\u0443\u0431\u0431\u043E\u0442\u0443 \u043C\u044B
      \u0441 \u043C\u0430\u043C\u043E\u0439 \u043F\u043E\u0439\u0434\u0451\u043C
      \u0432 \u0433\u0430\u043B\u0435\u0440\u0435\u044E, \u0447\u0442\u043E\u0431\u044B
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u044B."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u68EE\u6797"
    translation: "\u043B\u0435\u0441"
    image: {fileID: 0}
    exampleForeign: "\u7238\u7238\u5E38\u53BB\u68EE\u6797\u91C7\u6D46\u679C\uFF0C\u6628\u5929\u4ED6\u5F88\u65E9\u5C31\u53BB\u4E86\uFF0C\u665A\u4E0A\u624D\u56DE\u6765\u3002"
    exampleTranslation: "\u041E\u0442\u0435\u0446 \u0447\u0430\u0441\u0442\u043E
      \u0435\u0437\u0434\u0438\u0442 \u0432 \u043B\u0435\u0441 \u0437\u0430 \u044F\u0433\u043E\u0434\u0430\u043C\u0438,
      \u0430 \u0432\u0447\u0435\u0440\u0430 \u043E\u043D \u043F\u043E\u0435\u0445\u0430\u043B
      \u0442\u0443\u0434\u0430 \u043E\u0447\u0435\u043D\u044C \u0440\u0430\u043D\u043E
      \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0435\u0447\u0435\u0440\u043E\u043C."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6E56"
    translation: "\u043E\u0437\u0435\u0440\u043E"
    image: {fileID: 0}
    exampleForeign: "\u4E0A\u4E2A\u661F\u671F\u5929\u6211\u4EEC\u8D70\u4E86\u5927\u7EA6\u4E00\u4E2A\u5C0F\u65F6\u624D\u5230\u6E56\u8FB9\u3002"
    exampleTranslation: "\u0412 \u043F\u0440\u043E\u0448\u043B\u043E\u0435 \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u044C\u0435
      \u043C\u044B \u0448\u043B\u0438 \u043A \u043E\u0437\u0435\u0440\u0443 \u043E\u043A\u043E\u043B\u043E
      \u0447\u0430\u0441\u0430."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u6559\u5802"
    translation: "\u0441\u043E\u0431\u043E\u0440"
    image: {fileID: 0}
    exampleForeign: "\u6E38\u5BA2\u4EEC\u8D70\u4E86\u5F88\u4E45\u624D\u5230\u8001\u6559\u5802\uFF0C\u7136\u540E\u7ED9\u4ED6\u4EEC\u7684\u5BFC\u6E38\u6253\u7535\u8BDD\u8BF4\u5DF2\u7ECF\u7D2F\u4E86\u3002"
    exampleTranslation: "\u0422\u0443\u0440\u0438\u0441\u0442\u044B \u0434\u043E\u043B\u0433\u043E
      \u0448\u043B\u0438 \u043A \u0441\u0442\u0430\u0440\u043E\u043C\u0443 \u0441\u043E\u0431\u043E\u0440\u0443,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u043B\u0438
      \u0441\u0432\u043E\u0435\u043C\u0443 \u0433\u0438\u0434\u0443 \u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0443\u0436\u0435 \u0443\u0441\u0442\u0430\u043B\u0438."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
  - foreignWord: "\u5EFA\u7B51\u5E08"
    translation: "\u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440"
    image: {fileID: 0}
    exampleForeign: "\u6211\u7684\u53D4\u53D4\u662F\u5EFA\u7B51\u5E08\uFF0C\u6211\u559C\u6B22\u4ED6\u7684\u4F5C\u54C1\u3002"
    exampleTranslation: "\u041C\u043E\u0439 \u0434\u044F\u0434\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u043E\u043C, \u0438
      \u044F \u043B\u044E\u0431\u043B\u044E \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u044B."
    frontAudio: {fileID: 0}
    backAudio: {fileID: 0}
